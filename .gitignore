iosApp/*.xcodeproj/
iosApp/DerivedData/
iosApp/Sources/Info.plist
*.xcresult/

# Play policy audit scratch output (android-skills:play-policy-insights).
.scratch/

# Python (art/ scripts)
__pycache__/
