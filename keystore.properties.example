# Copy to `keystore.properties` (gitignored) and fill in your upload key details.
# Paths are resolved relative to the repo root. Keep the .jks file OUTSIDE the repo.
#
# Generate the upload key once with:
#   keytool -genkeypair -v -keystore upload-keystore.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# When keystore.properties is absent, the release build is left unsigned (debug/CI keep working).

storeFile=../upload-keystore.jks
storePassword=changeit
keyAlias=upload
keyPassword=changeit
