# Copy to `keystore.properties` (gitignored) and fill in your upload key details.
# Keep the keystore OUTSIDE the repo, in ~/keystores/, named after the app. Use an absolute path:
# Gradle does not expand `~`, and relative paths resolve against the repo root.
#
# Generate the upload key once with:
#   keytool -genkeypair -v -keystore ~/keystores/klas-upload.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# When keystore.properties is absent, the release build is left unsigned (debug/CI keep working).

storeFile=C:/Users/<you>/keystores/klas-upload.jks
storePassword=changeit
keyAlias=upload
keyPassword=changeit
