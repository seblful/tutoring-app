<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!--
      A lesson reminder is time-critical: «занятие через час» is worthless an hour late, so it rides an
      alarm rather than deferrable work (see notifications/ReminderAlarms).

      SCHEDULE_EXACT_ALARM, not USE_EXACT_ALARM: the latter is reserved by Play policy for alarm-clock
      and calendar apps and cannot be revoked, which is more than a tutoring reminder can justify. This
      one is granted by default on Android 13, user-revocable, and off by default on 14+ — so the app
      never assumes it, asks each time, and falls back to an inexact wake-up when it is refused.

      RECEIVE_BOOT_COMPLETED because alarms do not survive a restart and nothing else would put them
      back (WorkManager used to do that for free) — see work/BootReceiver.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      WorkManager declares a foreground service for workers that call `setForeground`. None does — the
      digests are deferrable and short — so the service and its permission are removed rather than shipped
      unused. detekt forbids importing `ForegroundInfo` while they are gone.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <!--
      No platform backup, on purpose — see res/xml/data_extraction_rules.xml for the argument.
      The app's own JSON export (Ещё → Резервная копия) is how data moves between devices.
    -->
    <!--
      enableOnBackInvokedCallback opts into the predictive back gesture (Android 13+, animated on 14+).
      Without it the system has nothing to preview during the swipe, so on a device that has trained the
      tutor to expect a peek at where they are going, this app is the one that just cuts. Navigation
      Compose animates its own transitions through it; ignored below API 33.
    -->
    <application
        android:name=".KlasApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locale_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Klas"
        tools:targetApi="33">
        <!--
          The launcher entry wears the *starting* theme, not the app's. `installSplashScreen()` swaps in
          `Theme.Klas` (its `postSplashScreenTheme`) the moment the activity is created, so the splash is
          the only thing that ever renders under it.
        -->
        <!--
          configChanges: turning the phone, or folding and resizing its window, is handled in place rather
          than by rebuilding the activity. The whole UI is Compose, which re-lays itself out for a new size
          on its own — and a rebuild threw away every dialog that was open and whatever had been typed into
          it: a payment half-entered, a piece of homework, a question about to be answered. Theme and
          language changes still rebuild, as they must.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:theme="@style/Theme.Klas.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The app's own links, klas://today and the like (TrayNavigation.destinationForLink). They only
                 ever open somewhere: any app or page can send one, so none of them writes anything. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="klas" />
            </intent-filter>
        </activity>

        <!-- Where a due reminder lands. Not exported: only this app's own alarms address it. -->
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />

        <!--
          Where a tap on a reminder's «Проведено» lands. Not exported either: the only thing that may
          mark a lesson taught without opening the app is this app's own notification.
        -->
        <receiver
            android:name=".notifications.ReminderActionReceiver"
            android:exported="false" />

        <!-- Alarms are cleared by a restart, so the plan is re-derived once the device is back. -->
        <receiver
            android:name=".work.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Digests are planned in the zone of the pass that planned them, so a timezone change (or a
          wall clock set by hand) re-plans them, rather than leaving the next upkeep pass to notice.
        -->
        <receiver
            android:name=".work.ClockChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!--
          Home-screen widgets. Exported, as the launcher's widget host must reach them. Today's receiver also
          takes its own midnight alarm (TodayWidgetUpdates); anyone else sending that only redraws the widget.
        -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <receiver
            android:name=".widget.QuickActionsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick_actions_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_actions_info" />
        </receiver>

        <!--
          Lends one file at a time to whichever app the tutor picks from the share sheet — the report
          CSV, written to `cache/shared` by `AndroidDocumentSharing`.

          `exported="false"` with `grantUriPermissions="true"` is the pair that matters: nothing can
          query this provider by authority, and the only way in is the read grant that travels with the
          `ACTION_SEND` intent and expires with it. `res/xml/file_paths.xml` narrows it to that one
          directory — this app's own files include every student's name, phone and email.

          The authority carries `${applicationId}`, so the debug build's provider is distinct from the
          release one; installing both side by side with the same authority fails at install time.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          We provide our own WorkManager configuration (the graph's worker factory) from KlasApp
          (Configuration.Provider), so disable the default on-startup initializer.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- See FOREGROUND_SERVICE above. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
    </application>

</manifest>
