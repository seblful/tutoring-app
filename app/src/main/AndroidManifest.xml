<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!--
      A lesson reminder is time-critical: «занятие через час» is worthless an hour late, so it rides an
      alarm rather than deferrable work (see notifications/ReminderAlarms).

      SCHEDULE_EXACT_ALARM, not USE_EXACT_ALARM: the latter is reserved by Play policy for alarm-clock
      and calendar apps and cannot be revoked, which is more than a tutoring reminder can justify. This
      one is granted by default on Android 13, user-revocable, and off by default on 14+ — so the app
      never assumes it, asks each time, and falls back to an inexact wake-up when it is refused.

      RECEIVE_BOOT_COMPLETED because alarms do not survive a restart and nothing else would put them
      back (WorkManager used to do that for free) — see work/BootReceiver.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      No platform backup, on purpose — see res/xml/data_extraction_rules.xml for the argument.
      The app's own JSON export (Ещё → Резервная копия) is how data moves between devices.
    -->
    <application
        android:name=".KlasApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Klas"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Klas">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Where a due reminder lands. Not exported: only this app's own alarms address it. -->
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />

        <!-- Alarms are cleared by a restart, so the plan is re-derived once the device is back. -->
        <receiver
            android:name=".work.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          We provide our own Hilt-aware WorkManager configuration from KlasApp
          (Configuration.Provider), so disable the default on-startup initializer.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
